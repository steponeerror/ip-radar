# ipradar-fleet.timer — M5 加源舰队排程件(#366;装机由人)
# 每小时拍一次(票面「笔记本 timer 驱动」):有活干一源,没活 exit 0 零模型调用。
# Persistent=true 补跑错过的拍(停机跨拍只补一拍)。同拍互斥:service 在跑时 timer
# 不重入(oneshot active 期间不重触发);一拍超 1h 被 TimeoutStartSec 击杀 → 下拍
# in_flight 续跑同轮(run-add 幂等),不双花。

[Unit]
Description=ip-radar M5 加源舰队排程(#366)

[Timer]
OnCalendar=hourly
Persistent=true

[Install]
WantedBy=default.target
